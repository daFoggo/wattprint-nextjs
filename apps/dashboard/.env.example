# The dashboard supports only AUTH_PROVIDER=keycloak (docs/providers.md): realm `wattprint` of wattprint-fastapi,
# Google sign-in through `kc_idp_hint=google`. The Keycloak access token is sent to FastAPI as Bearer.
AUTH_PROVIDER=keycloak
KEYCLOAK_ISSUER=http://localhost:8180/realms/wattprint
KEYCLOAK_CLIENT_ID=wattprint-web
# Required: WATTPRINT_WEB_CLIENT_SECRET from wattprint-fastapi/.env (docker compose up -d keycloak there)
KEYCLOAK_CLIENT_SECRET=

API_BASE_URL=http://localhost:8000

NEXT_PUBLIC_APP_URL=http://localhost:3001
# Where the logo and "Back to home" on the sign-in page go (apps/web).
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
