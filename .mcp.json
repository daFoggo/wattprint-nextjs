{
  "mcpServers": {
    "hairline-ui": {
      "type": "http",
      "url": "https://hairlineui.com/api/mcp"
    },
    "awwwards": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "awwwards-mcp"
      ],
      "env": {}
    },
    "shadcn": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "shadcn@4.23.0",
        "mcp"
      ],
      "env": {}
    }
  }
}
